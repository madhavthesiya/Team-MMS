# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Leave empty to use local SQLite (behindthemark.db in the repo root).
# Production: Neon Postgres connection string (postgresql://...).
DATABASE_URL=
# Optional multi-key rotation (comma-separated keys):
# GEMINI_API_KEYS=key1,key2,key3
# Optional Groq failover key (free from https://console.groq.com/keys):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEYS=key1,key2
CERTAINTY_THRESHOLD=0.7
# Max seconds for one model call / for all model calls in one request (frontend waits 45 s).
AI_TIMEOUT_SECONDS=20
AI_BUDGET_SECONDS=30
# Per IP for create-class/join (a whole class shares one Wi-Fi IP); per student for answers.
RATE_LIMIT_PUBLIC=120/minute
RATE_LIMIT_STUDENT=20/minute
# Riddle 4: a re-check this many days after the first answer can show the understanding lasted.
RECHECK_LASTING_DAYS=7
